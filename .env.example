# ─── Supabase ────────────────────────────────────────────────────────────────
# Panel del proyecto → Settings → API
# La URL es pública (va en el bundle). La service role key NO: se salta cualquier
# política de seguridad, así que solo se usa desde el servidor y nunca se commitea.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Recorte de fondo ────────────────────────────────────────────────────────
# Proveedor a usar: fal | photoroom | removebg
BG_REMOVAL_PROVIDER=fal

# Solo hace falta la clave del proveedor elegido arriba.
FAL_KEY=                  # https://fal.ai/dashboard/keys
PHOTOROOM_API_KEY=        # https://www.photoroom.com/api
REMOVE_BG_API_KEY=        # https://www.remove.bg/dashboard#api-key

# ─── Claude ──────────────────────────────────────────────────────────────────
# Etiqueta cada prenda y, si lo activas, reordena y redacta los conjuntos.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional: modelo a usar. Por defecto claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
